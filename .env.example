OPENAI_DEFAULT_MODEL="gpt-4.1-mini"
OPENAI_INPUT_COST_PER_1K_USD="0"
OPENAI_OUTPUT_COST_PER_1K_USD="0"

CUSTOM_OPENAI_API_KEY=""
CUSTOM_OPENAI_BASE_URL=""
CUSTOM_OPENAI_DEFAULT_MODEL=""
CUSTOM_OPENAI_INPUT_COST_PER_1K_USD="0"
CUSTOM_OPENAI_OUTPUT_COST_PER_1K_USD="0"

AI_PROVIDER_TIMEOUT_MS="60000"

# Production readiness checks. Configure real auth and monitoring before public paid traffic.
AUTH_PROVIDER=""
AUTH_SECRET=""
