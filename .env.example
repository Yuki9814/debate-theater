DATABASE_URL="file:./dev.db"

# Public deployment origin used for CSRF/Origin checks and Stripe return URLs.
APP_ORIGIN="http://localhost:3000"

# Demo fallback is disabled unless explicitly enabled outside production.
DEMO_MODE="false"
ADMIN_EMAILS=""

# Required before storing real user/provider API keys.
# Use at least 32 random characters in production.
API_KEY_ENCRYPTION_SECRET=""

# Optional server-side provider keys. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_DEFAULT_MODEL="gpt-4.1-mini"
OPENAI_INPUT_COST_PER_1K_USD="0"
OPENAI_OUTPUT_COST_PER_1K_USD="0"

CUSTOM_OPENAI_API_KEY=""
CUSTOM_OPENAI_BASE_URL=""
CUSTOM_OPENAI_DEFAULT_MODEL=""
CUSTOM_OPENAI_INPUT_COST_PER_1K_USD="0"
CUSTOM_OPENAI_OUTPUT_COST_PER_1K_USD="0"

AI_PROVIDER_TIMEOUT_MS="60000"

# Comma-separated HTTPS provider hosts/origins allowed for custom OpenAI-compatible endpoints.
PROVIDER_BASE_URL_ALLOWLIST="api.openai.com"
ALLOW_LOCAL_PROVIDER_URLS="false"

# Production readiness checks. Configure real auth and monitoring before public paid traffic.
AUTH_PROVIDER=""
AUTH_SECRET=""
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""

# In production, enable proxy headers only when the deployment proxy is trusted.
TRUST_PROXY_HEADERS="false"
RATE_LIMIT_BACKEND="memory"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Mock billing keeps local development usable while preserving a server-side
# entitlement boundary for paid launch.
BILLING_MODE="mock"
PLATFORM_FREE_ROUND_CREDITS="120"

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_STUDIO_MONTHLY=""
